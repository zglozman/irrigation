# Copy this file to secrets.yaml (already gitignored) and fill in real values.

# Fallback Wi-Fi, used only if the Ethernet PHY doesn't come up.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Password for local OTA updates and the fallback AP.
ota_password: "REPLACE_WITH_A_STRONG_PASSWORD"

# AWS IoT Core — from `aws iot describe-endpoint --endpoint-type iot:Data-ATS`
aws_iot_endpoint: "xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"

# Amazon Root CA 1 — https://www.amazontrust.com/repository/AmazonRootCA1.pem
aws_root_ca: |
  -----BEGIN CERTIFICATE-----
  ...paste AmazonRootCA1.pem contents...
  -----END CERTIFICATE-----

# Device certificate + private key — from `aws iot create-keys-and-certificate`
aws_iot_device_cert: |
  -----BEGIN CERTIFICATE-----
  ...paste device certificate...
  -----END CERTIFICATE-----

aws_iot_device_key: |
  -----BEGIN RSA PRIVATE KEY-----
  ...paste device private key...
  -----END RSA PRIVATE KEY-----

# Cloud OTA manifest (JSON produced by `esphome compile` + uploaded to S3).
ota_manifest_url: "https://YOUR-BUCKET.s3.amazonaws.com/firmware/manifest.json"
