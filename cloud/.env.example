# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
TABLE_NAME=IrrigationApp
DATA_BUCKET=irrigation-data-bucket
ATHENA_DB=irrigation
ATHENA_TABLE=irrigation_events
ATHENA_OUTPUT=s3://irrigation-data-bucket/athena-results/

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=client-id-here
COGNITO_CLIENT_SECRET=client-secret-here

# IoT Configuration
IOT_TOPIC_PREFIX=irrigation-controller

# Weather Configuration
# Tomorrow.io API key (required)
TOMORROW_API_KEY=your-tomorrow-io-api-key

# WeatherFlow Tempest (optional for rainfall override)
TEMPEST_TOKEN=optional-tempest-api-token
TEMPEST_STATION_ID=optional-tempest-station-id
TEMPEST_DEVICE_ID=optional-tempest-device-id

# Location Configuration
LATITUDE=40.7128
LONGITUDE=-74.0060
TIMEZONE=America/New_York

# System Configuration
SUPPLY_CAPACITY_GPH=600

# Chat Assistant Configuration (AWS Bedrock + Claude)
# Note: Anthropic model access must be enabled in the AWS Bedrock console for your region
# Available models: anthropic.claude-opus-5 (default), anthropic.claude-sonnet-5, anthropic.claude-haiku-4-5
CHAT_MODEL=anthropic.claude-opus-5
